@startuml
' CSE 360 Team Project - TP1 Sequence Diagram: One-Time Password
' Author: A.G. (agupt545) - Design Documents and Architecture
' Version 1.00, 2026-09-17

title TP1 Sequence - Admin issues a one-time password and the user redeems it

skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11

actor Admin
actor "User" as EndUser
participant "ViewAdminHome" as VAH
participant "ControllerAdminHome" as CAH
participant "ViewOneTimePassword" as VOTP
participant "ControllerOneTimePassword" as COTP
participant "Database" as DB
participant "ViewUserLogin" as VUL
participant "ControllerUserLogin" as CUL
participant "PasswordPopupWindow" as PW

== Admin sets the one-time password ==
Admin -> VAH : press "Set a One-Time Password"
VAH -> CAH : setOnetimePassword()
CAH -> VOTP : displayOneTimePassword(stage, admin)
VOTP -> COTP : reloadUserList()
COTP -> DB : getUserList()
DB --> COTP : list of usernames
Admin -> VOTP : select a user, choose a deadline, press Generate
VOTP -> COTP : performGenerate()
COTP -> CAH : validateInvitationDeadline(deadline)
CAH --> COTP : "" (acceptable) or an error message
alt deadline not acceptable
  COTP --> Admin : alert explaining the deadline rule
else deadline acceptable
  COTP -> COTP : generateOneTimePassword()
  COTP -> DB : setOneTimePassword(user, otp, deadline)
  DB --> COTP : true
  COTP --> Admin : display the one-time password once
end

== User redeems the one-time password ==
EndUser -> VUL : enter username and the one-time password
VUL -> CUL : doLogin(stage)
CUL -> DB : getUserAccountDetails(username)
DB --> CUL : true
CUL -> CUL : password does not match the stored password
CUL -> DB : loginWithOneTimePassword(username, otp)
alt one-time password expired or wrong
  DB --> CUL : false
  CUL --> EndUser : "Incorrect username/password. Try again!"
else one-time password accepted
  DB --> CUL : true
  CUL -> PW : show()
  PW --> CUL : a password that satisfies every requirement
  alt the user closed the window
    CUL --> EndUser : "You must set a new password"
    note right : nothing is changed and the login does not proceed
  else a new password was chosen
    CUL -> DB : updatePassword(username, newPassword)
    CUL -> DB : clearOneTimePassword(username)
    note right : the one-time password can never be used again
    CUL -> DB : getNumberOfRoles(user)
    CUL --> EndUser : the user's home page
  end
end

@enduml
